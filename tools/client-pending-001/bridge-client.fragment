  ClientPendingStore Pending;Dictionary<string,string> LastSendKeys=new Dictionary<string,string>();
  string LogicalScope(string project,string workspace){return project+"\n"+workspace;}
  public PendingClientSend PendingSend(string project,string workspace){return Pending.Peek(project,workspace);}
  public void FinishLogicalSend(string project,string workspace){string key;if(LastSendKeys.TryGetValue(LogicalScope(project,workspace),out key)){Pending.Consume(project,workspace,key);LastSendKeys.Remove(LogicalScope(project,workspace));}}
  public async Task<object> ReplayPending(string project,string workspace){var r=Pending.Peek(project,workspace);if(r==null)throw new InvalidOperationException("本会话没有待核对的客户端请求。");return await SendTracked(new PendingSendTicket(){Record=r,IsNew=false});}
  object Cached(PendingClientSend r){var value=Json.Codec.DeserializeObject(r.ResponseJson);if(r.State=="REJECTED")return Json.D("status","CLIENT_REQUEST_REJECTED","summary","原API请求已被后台拒绝："+Friendly(Json.Str(value,"error")),"governance",Json.Get(value,"governance"));return value;}
  async Task<object> SendTracked(PendingSendTicket ticket){var r=ticket.Record;LastSendKeys[LogicalScope(r.ProjectId,r.WorkspaceId)]=r.RequestKey;if(r.State!="PENDING")return Cached(r);try{string raw=await Request(r.Path,r.Payload,r.RequestKey);var value=Json.Codec.DeserializeObject(raw);Pending.RecordResponse(r,raw,false);return value;}catch(ApiCallFailure error){if(ticket.IsNew&&new[]{400,403,404,409,422,429}.Contains(error.StatusCode)&&!String.IsNullOrEmpty(error.ResponseJson)){var response=Json.Codec.DeserializeObject(error.ResponseJson);if(!String.IsNullOrEmpty(Json.Str(response,"error")))Pending.RecordResponse(r,error.ResponseJson,true);}throw;}}
  public async Task<object> Call(string path,object body=null){string payload=body==null?null:Json.Show(body);if(body!=null&&ClientPendingStore.Tracks(path))return await SendTracked(Pending.Prepare(path,payload));return Json.Codec.DeserializeObject(await Request(path,payload,body==null?null:Guid.NewGuid().ToString("N")));}
  sealed class ApiCallFailure:InvalidOperationException {public int StatusCode;public string ResponseJson;public ApiCallFailure(string message):base(message){}}
  async Task<string> Request(string path,string payload,string key){using(var web=new WebClient()){web.Proxy=null;web.Encoding=Encoding.UTF8;web.Headers[HttpRequestHeader.Authorization]="Bearer "+Token;try{if(payload==null)return await web.DownloadStringTaskAsync(Base+path);web.Headers[HttpRequestHeader.ContentType]="application/json; charset=utf-8";web.Headers["Idempotency-Key"]=key;return await web.UploadStringTaskAsync(Base+path,"POST",payload);}catch(WebException e){string message=e.Message,raw=null;object governance=null;int code=0;if(e.Response!=null){var http=e.Response as HttpWebResponse;if(http!=null)code=(int)http.StatusCode;using(var sr=new StreamReader(e.Response.GetResponseStream())){var candidate=sr.ReadToEnd();try{var parsed=Json.Codec.DeserializeObject(candidate);message=Json.Str(parsed,"error");governance=Json.Get(parsed,"governance");raw=candidate;}catch{}}}var operation=new ApiCallFailure(Friendly(message)){StatusCode=code,ResponseJson=raw};if(governance!=null)operation.Data["governance"]=governance;throw operation;}}}
