 public sealed class PendingClientSend {
  public string ProjectId,WorkspaceId,RequestKey,Path,Payload,PayloadHash,State,ResponseJson,OriginalText,ReplyId,CreatedAt;
 }
 public sealed class PendingSendTicket {public PendingClientSend Record;public bool IsNew;}
 public sealed class ClientPendingStore {
  string Folder,FilePath;byte[] Entropy;
  public static bool Tracks(string path){return System.Text.RegularExpressions.Regex.IsMatch(path??"","^/api/workspaces/[A-Za-z0-9-]+/(intent|chat|reply)$");}
  static string Hash(string value){using(var h=SHA256.Create())return BitConverter.ToString(h.ComputeHash(Encoding.UTF8.GetBytes(value))).Replace("-","").ToLowerInvariant();}
  static void NoLinks(string path){var d=new DirectoryInfo(path);while(d!=null){if(d.Exists&&(d.Attributes&FileAttributes.ReparsePoint)!=0)throw new IOException("发送恢复档案目录不能通过链接跳转。");d=d.Parent;}}
  static string ScopeKey(string project,string workspace){if(String.IsNullOrEmpty(project)||String.IsNullOrEmpty(workspace)||project.Length>160||workspace.Length>160)throw new InvalidOperationException("发送缺少准确项目与会话。");return Hash(project+"\n"+workspace);}
  public ClientPendingStore(string config){string full=Path.GetFullPath(config);Folder=Path.Combine(Path.GetDirectoryName(full),"client-pending");NoLinks(Folder);Entropy=Encoding.UTF8.GetBytes(Hash(full.ToLowerInvariant()));FilePath=Path.Combine(Folder,Hash(full.ToLowerInvariant()).Substring(0,24)+".bin");}
  FileStream Lease(){NoLinks(Folder);Directory.CreateDirectory(Folder);NoLinks(Folder);if(File.Exists(FilePath+".lock")&&(File.GetAttributes(FilePath+".lock")&FileAttributes.ReparsePoint)!=0)throw new IOException("发送恢复锁不能是链接。");return new FileStream(FilePath+".lock",FileMode.OpenOrCreate,FileAccess.ReadWrite,FileShare.None);}
  static PendingClientSend Copy(PendingClientSend record){return record==null?null:Json.Codec.Deserialize<PendingClientSend>(Json.Show(record));}
  static PendingClientSend Describe(string path,string payload){
   if(!Tracks(path))throw new InvalidOperationException("不支持的发送恢复路径。");var body=Json.Codec.DeserializeObject(payload);string project=Json.Str(body,"projectId"),workspace=path.Split('/')[3];ScopeKey(project,workspace);
   return new PendingClientSend(){ProjectId=project,WorkspaceId=workspace,Path=path,Payload=payload,PayloadHash=Hash(payload),OriginalText=Json.Str(body,"text"),ReplyId=path.EndsWith("/reply")?Json.Str(body,"messageId"):Json.Str(body,"replyTo")};
  }
  Dictionary<string,PendingClientSend> Read(){
   if(!File.Exists(FilePath))return new Dictionary<string,PendingClientSend>();if((File.GetAttributes(FilePath)&FileAttributes.ReparsePoint)!=0||new FileInfo(FilePath).Length>8000000)throw new IOException("发送恢复档案无效。");
   var plain=ProtectedData.Unprotect(File.ReadAllBytes(FilePath),Entropy,DataProtectionScope.CurrentUser);var all=Json.Codec.Deserialize<Dictionary<string,PendingClientSend>>(Encoding.UTF8.GetString(plain));if(all==null)throw new IOException("发送恢复档案损坏，不创建替代发送。");
   foreach(var pair in all){var r=pair.Value;if(r==null||r.Payload==null||r.Payload.Length>1000000)throw new IOException("发送恢复记录损坏。");var expected=Describe(r.Path,r.Payload);if(pair.Key!=ScopeKey(r.ProjectId,r.WorkspaceId)||r.ProjectId!=expected.ProjectId||r.WorkspaceId!=expected.WorkspaceId||r.PayloadHash!=Hash(r.Payload)||r.OriginalText!=expected.OriginalText||r.ReplyId!=expected.ReplyId||!System.Text.RegularExpressions.Regex.IsMatch(r.RequestKey??"","^[a-f0-9]{32}$")||!new[]{"PENDING","ACKNOWLEDGED","REJECTED"}.Contains(r.State))throw new IOException("发送恢复记录不匹配，不创建替代发送。");if(r.State!="PENDING"){if(String.IsNullOrEmpty(r.ResponseJson))throw new IOException("发送结果档案缺失。");Json.Codec.DeserializeObject(r.ResponseJson);}}
   return all;
  }
  void Write(Dictionary<string,PendingClientSend> all){
   var plain=Encoding.UTF8.GetBytes(Json.Show(all));if(plain.Length>6000000)throw new IOException("发送恢复档案超过限制，停止本次新发送。");var bytes=ProtectedData.Protect(plain,Entropy,DataProtectionScope.CurrentUser);string temp=FilePath+".next-"+Guid.NewGuid().ToString("N");using(var f=new FileStream(temp,FileMode.CreateNew,FileAccess.Write,FileShare.None)){f.Write(bytes,0,bytes.Length);f.Flush(true);}if(File.Exists(FilePath)){if((File.GetAttributes(FilePath)&FileAttributes.ReparsePoint)!=0)throw new IOException("发送恢复档案不能是链接。");File.Replace(temp,FilePath,null);}else File.Move(temp,FilePath);
  }
  public PendingClientSend Peek(string project,string workspace){using(Lease()){var all=Read();PendingClientSend old;return all.TryGetValue(ScopeKey(project,workspace),out old)?Copy(old):null;}}
  public PendingSendTicket Prepare(string path,string payload){
   var candidate=Describe(path,payload);using(Lease()){var all=Read();string scope=ScopeKey(candidate.ProjectId,candidate.WorkspaceId);PendingClientSend old;if(all.TryGetValue(scope,out old)){if(old.Path!=path||old.Payload!=payload)throw new InvalidOperationException("本会话有上次发送待核对；当前编辑稿已保留。请先核对原请求，不能复用旧键发送不同正文或接收者。");return new PendingSendTicket(){Record=Copy(old),IsNew=false};}candidate.RequestKey=Guid.NewGuid().ToString("N");candidate.State="PENDING";candidate.CreatedAt=DateTime.UtcNow.ToString("o");all[scope]=candidate;Write(all);return new PendingSendTicket(){Record=Copy(candidate),IsNew=true};}
  }
  public void RecordResponse(PendingClientSend r,string response,bool rejected){Json.Codec.DeserializeObject(response);using(Lease()){var all=Read();PendingClientSend old;string scope=ScopeKey(r.ProjectId,r.WorkspaceId);if(!all.TryGetValue(scope,out old)||old.RequestKey!=r.RequestKey)return;if(old.State!="PENDING"&&old.ResponseJson!=response)throw new IOException("同一请求出现不同结果，保留待核对记录。");old.State=rejected?"REJECTED":"ACKNOWLEDGED";old.ResponseJson=response;Write(all);}}
  public void Consume(string project,string workspace,string key){using(Lease()){var all=Read();PendingClientSend old;string scope=ScopeKey(project,workspace);if(!all.TryGetValue(scope,out old)||old.RequestKey!=key)return;if(old.State=="PENDING")throw new InvalidOperationException("原API结果仍待核对，不能丢弃请求键或重发。");all.Remove(scope);Write(all);}}
  public static bool ClearRecoveredDraft(PendingClientSend r,string currentPath,string currentPayload,object result){return r.Path==currentPath&&r.Payload==currentPayload&&(!r.Path.EndsWith("/intent")||Json.Str(result,"status")=="EXECUTED")&&Json.Str(result,"status")!="CLIENT_REQUEST_REJECTED";}
 }
