  async Task Send(){if(Sending)return;if(CurrentScope==null||String.IsNullOrEmpty(CurrentScope.WorkspaceId))throw new InvalidOperationException("先选择一个会话。");var pending=Client.PendingSend(CurrentScope.ProjectId,CurrentScope.WorkspaceId);if(pending!=null){await RecoverClientSend(pending);return;}RequireDurableDraftForSend();string project=CurrentScope.ProjectId,workspace=CurrentScope.WorkspaceId;
   if(UxMode){try{await SendUx();RequireDurableDraftForSend();Client.FinishLogicalSend(project,workspace);}finally{RefreshPendingSendUi();}return;}
   if(String.IsNullOrWhiteSpace(Composer.Text))throw new InvalidOperationException("请输入文字。");if(Chosen().Length==0)throw new InvalidOperationException("请明确选择接收方，正文中的 @ 不作为路由依据。");string text=Composer.Text,reply=ReplyId;Sending=true;Composer.IsEnabled=false;C<Button>("SendButton").IsEnabled=false;
   try{if(reply==null)await Post("chat","text",text,"recipients",Chosen(),"knowledgeRefs",AttachedKnowledge.ToArray());else await Post("reply","messageId",reply,"text",text,"recipients",Chosen(),"knowledgeRefs",AttachedKnowledge.ToArray());LocalDraft saved;if(Drafts.TryGetValue(workspace,out saved)&&saved.Text==text&&saved.ReplyId==reply)Drafts[workspace]=new LocalDraft();if(CurrentScope.WorkspaceId==workspace&&Composer.Text==text&&ReplyId==reply){Composer.Clear();ReplyId=null;ReplyBanner.Visibility=Visibility.Collapsed;AttachedKnowledge.Clear();}RequireDurableDraftForSend();Client.FinishLogicalSend(project,workspace);await RefreshWorkspace();}
   finally{Sending=false;Composer.IsEnabled=true;C<Button>("SendButton").IsEnabled=Chosen().Length>0;RefreshPendingSendUi();}
  }
