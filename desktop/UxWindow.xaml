 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource ThemeColor8}" BorderBrush="{DynamicResource ThemeColor3}" BorderThickness="0,0,0,1" Padding="22,12">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
     <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource QuietButton}" ToolTip="刷新当前项目与会话"/>
     <Button x:Name="ThemeToggleButton" Content="深色模式" Style="{StaticResource QuietButton}" ToolTip="切换浅色或深色并记住选择"/>
     <Button x:Name="ContextToggleButton" Content="收起上下文" Style="{StaticResource QuietButton}" ToolTip="显示或收起当前会话上下文"/>
     <Expander x:Name="SettingsExpander" Header="设置与窗口" Margin="10,7,0,0" VerticalAlignment="Top">
      <Border Background="{DynamicResource ThemeColor17}" BorderBrush="{DynamicResource ThemeColor3}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,10,0,0" MaxWidth="390">
       <StackPanel><WrapPanel><Button x:Name="NewWindowButton" Content="另开原生窗口"/><Button x:Name="CloseWindowButton" Content="关闭窗口"/><Button x:Name="StopBackendButton" Content="停止后台…"/></WrapPanel><Separator Margin="2,9"/><WrapPanel><Button x:Name="BindButton" Content="绑定模拟会话…"/><Button x:Name="PauseBindingButton" Content="暂停 / 恢复模拟接入…"/></WrapPanel><CheckBox x:Name="DiscussionCheck" Content="明确开启受限定向讨论" Margin="7,10,5,6"/><TextBlock x:Name="ModeWindowNote" Text="关闭窗口不会停止后台。真实 Agent 会话保持锁定。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeColor2}" Margin="6,5"/></StackPanel>
      </Border>
     </Expander>
    </StackPanel>
    <StackPanel Margin="0,0,20,0"><StackPanel Orientation="Horizontal"><TextBlock Text="TriReviewBridge" FontSize="19" FontWeight="SemiBold"/><Border Background="{DynamicResource ThemeColor18}" CornerRadius="4" Padding="7,3" Margin="12,0,0,0"><TextBlock x:Name="ModeBadge" Text="离线模拟" FontSize="11" Foreground="{DynamicResource ThemeColor9}"/></Border></StackPanel><TextBlock x:Name="LocationText" Text="选择项目与会话" FontSize="13" Foreground="{DynamicResource ThemeColor2}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
   </DockPanel>
  </Border>
  <Border x:Name="AttentionBanner" Grid.Row="1" Background="{DynamicResource ThemeColor19}" BorderBrush="{DynamicResource ThemeColor20}" BorderThickness="0,0,0,1" Padding="22,10" Visibility="Collapsed"><TextBlock x:Name="AttentionText" TextWrapping="Wrap" Foreground="{DynamicResource ThemeColor21}" FontSize="13" LineHeight="21"/></Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ContextColumn" Width="270"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{DynamicResource ThemeColor0}" BorderBrush="{DynamicResource ThemeColor3}" BorderThickness="0,0,1,0" Padding="13,17,10,12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="项目与会话" FontWeight="SemiBold" Margin="8,0,0,10"/><WrapPanel><Button x:Name="NewProjectButton" Content="＋ 项目" Style="{StaticResource QuietButton}"/><Button x:Name="NewWorkspaceButton" Content="＋ 会话" Style="{StaticResource QuietButton}"/></WrapPanel><TextBlock Text="历史、接收方与草稿按会话保存" FontSize="11" Foreground="{DynamicResource ThemeColor2}" Margin="8,5,0,14" TextWrapping="Wrap"/></StackPanel>
     <Expander DockPanel.Dock="Bottom" Header="项目与会话管理" Margin="2,12,0,0"><ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,8,0,0"><Button x:Name="RenameProjectButton" Content="重命名项目…"/><Button x:Name="ProjectSettingsButton" Content="项目设置与权限…"/><Button x:Name="KnowledgeButton" Content="项目知识…"/><Button x:Name="ArchiveProjectButton" Content="归档项目…"/><Separator Margin="4,7"/><Button x:Name="RenameWorkspaceButton" Content="重命名会话…"/><Button x:Name="ArchiveWorkspaceButton" Content="归档当前会话…"/></StackPanel></ScrollViewer></Expander>
     <TreeView x:Name="ProjectTree" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Background="{DynamicResource ThemeColor8}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="18,10,18,4"><Button x:Name="PauseWorkspaceButton" Content="暂停此空间" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" FontSize="12"/><TextBlock Text="协作空间" FontSize="12" Foreground="{DynamicResource ThemeColor2}" VerticalAlignment="Center"/></DockPanel>
    <TabControl Grid.Row="1" x:Name="MainTabs">
     <TabItem Header="对话与消息">
      <DockPanel Margin="18,8,18,14">
       <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemeColor22}" BorderBrush="{DynamicResource ThemeColor23}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
        <StackPanel>
         <Border x:Name="ReplyBanner" Background="{DynamicResource ThemeColor24}" CornerRadius="4" Padding="8" Margin="0,0,0,8" Visibility="Collapsed"><DockPanel><Button x:Name="CancelReplyButton" Content="取消引用" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" FontSize="12"/><TextBlock x:Name="ReplyText" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/></DockPanel></Border>
         <TextBlock Text="接收方" FontSize="12" Foreground="{DynamicResource ThemeColor2}" Margin="2,0,0,5"/>
         <ListBox x:Name="RecipientList" SelectionMode="Multiple" MinHeight="36" MaxHeight="84" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="{DynamicResource ThemeColor22}"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,2,6,2"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{DynamicResource ThemeColor25}"/><Setter Property="Foreground" Value="{DynamicResource ThemeColor9}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RecipientChip" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RecipientChip" Property="Background" Value="{DynamicResource ThemeColor26}"/><Setter TargetName="RecipientChip" Property="BorderBrush" Value="{DynamicResource ThemeColor27}"/><Setter Property="Foreground" Value="{DynamicResource ThemeColor28}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RecipientChip" Property="BorderBrush" Value="{DynamicResource ThemeColor28}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
         <TextBlock x:Name="RecipientHint" Text="明确选择接收方后发送。正文、引用与代码中的 @ 不改变接收方。" FontSize="11" Foreground="{DynamicResource ThemeColor2}" TextWrapping="Wrap" Margin="2,5,2,8"/>
         <TextBox x:Name="Composer" MinHeight="84" Height="100" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" BorderThickness="0" Background="Transparent" Padding="2,5" ToolTip="支持多行。Ctrl+Enter 发送；只向明确选中的接收方投递。"/>
         <TextBlock x:Name="IntentStatusText" Text="" FontSize="12" Foreground="{DynamicResource ThemeColor9}" TextWrapping="Wrap" Margin="2,4,2,5"/>
         <DockPanel Margin="0,4,0,0"><Button x:Name="SendButton" Content="发送" DockPanel.Dock="Right" MinWidth="92" Style="{StaticResource PrimaryButton}" ToolTip="定向发送或执行已支持的协作请求；Ctrl+Enter"/><Button x:Name="AttachKnowledgeButton" Content="引用知识版本…" DockPanel.Dock="Left" Style="{StaticResource QuietButton}" FontSize="12" ToolTip="选择已共享的知识版本。不会上传文件到原会话。"/><TextBlock Text="Ctrl+Enter 发送" FontSize="11" Foreground="{DynamicResource ThemeColor2}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0"/></DockPanel>
        </StackPanel>
       </Border>
       <Expander DockPanel.Dock="Bottom" Header="选中消息与草稿操作" FontSize="12" Margin="2,8,0,0"><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><WrapPanel Margin="0,6,0,0"><Button x:Name="ReplyButton" Content="回复选中消息"/><Button x:Name="ForwardButton" Content="保留来源转交…"/><Button x:Name="MessageDetailsButton" Content="来源与技术详情"/><Button x:Name="MessageTaskButton" Content="以消息创建任务…"/><Button x:Name="MessageReviewButton" Content="以消息发起审批…"/><Button x:Name="ObservationButton" Content="记录差异观察…"/><Button x:Name="HybridEarlierHistoryButton" Content="更早历史…" Visibility="Collapsed"/><Button x:Name="RestoreDraftButton" Content="恢复本会话草稿…"/></WrapPanel></ScrollViewer></Expander>
       <ListBox x:Name="MessageList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Padding="0,4,0,0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="MessageSelection" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" CornerRadius="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="MessageSelection" Property="BorderBrush" Value="{DynamicResource ThemeColor27}"/><Setter TargetName="MessageSelection" Property="Background" Value="{DynamicResource ThemeColor29}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MessageSelection" Property="BorderBrush" Value="{DynamicResource ThemeColor7}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Padding="12,12,14,14" MaxWidth="900" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource ThemeColor14}" BorderThickness="0,0,0,1"><StackPanel><DockPanel><TextBlock Text="{Binding TimeLabel}" DockPanel.Dock="Right" Foreground="{DynamicResource ThemeColor2}" FontSize="11" Margin="16,2,0,0"/><TextBlock Text="{Binding AuthorLabel}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeColor7}" TextWrapping="Wrap" FontSize="13"/></DockPanel><TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="25" FontSize="15" Margin="0,8,0,6"/><TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource ThemeColor9}" FontSize="12" TextWrapping="Wrap" LineHeight="20"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StateLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Expander Header="来源与投递详情" FontSize="11" Margin="0,6,0,0"><TextBox Text="{Binding Technical}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="{DynamicResource ThemeColor30}" Margin="0,7,0,0"/></Expander></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel>
     </TabItem>
     <TabItem Header="任务与审批">
      <DockPanel Margin="18,16">
       <TextBlock DockPanel.Dock="Top" Text="任务、技术审议与用户授权分别记录。选择事项可查看版本及完整历史。" TextWrapping="Wrap" Foreground="{DynamicResource ThemeColor2}" FontSize="12" Margin="2,0,2,12"/>
       <WrapPanel DockPanel.Dock="Top"><Button x:Name="NewTaskButton" Content="新建文字任务…"/><Button x:Name="NewReviewButton" Content="新建正式审批…"/><Button x:Name="ItemDetailsButton" Content="快照、意见与历史"/><Button x:Name="HybridAcceptTaskButton" Content="接受文字结果" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="AuthorizeButton" Content="记录用户明确授权…"/></WrapPanel>
       <Expander DockPanel.Dock="Bottom" Header="事项更多操作" FontSize="12" Margin="2,12,0,0"><WrapPanel Margin="0,7,0,0"><Button x:Name="CrossButton" Content="明确开启交叉审查…"/><Button x:Name="ReviewRecordButton" Content="记录分歧与结论…"/><Button x:Name="ReviseButton" Content="修订并重新审批…"/><Button x:Name="CancelItemButton" Content="取消事项"/></WrapPanel></Expander>
       <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="性质" Binding="{Binding TypeLabel}" Width="85"/><DataGridTextColumn Header="事项" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="145"/><DataGridTextColumn Header="版本" Binding="{Binding Revision}" Width="55"/><DataGridTextColumn Header="用户授权" Binding="{Binding Authorized}" Width="90"/></DataGrid.Columns></DataGrid>
      </DockPanel>
     </TabItem>
     <TabItem Header="工程材料">
      <DockPanel Margin="18,16">
       <TextBlock DockPanel.Dock="Top" Text="离线材料 · 本机校验与人工交付分别记录，真实三方尚未接收。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeColor2}" Margin="2,0,2,10"/>
       <WrapPanel DockPanel.Dock="Top"><Button x:Name="MaterialsRefreshButton" Content="刷新"/><Button x:Name="MaterialsReadButton" Content="阅读选定材料"/><Button x:Name="MaterialsVerifyButton" Content="校验完整性"/><Button x:Name="MaterialsDetailsButton" Content="版本与哈希详情"/></WrapPanel>
       <TextBlock x:Name="MaterialsReceiptsText" DockPanel.Dock="Top" Text="尚无模拟材料收件；真实三方未交付。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeColor9}" Margin="4,10,4,5"/><TextBlock x:Name="MaterialsSourceText" DockPanel.Dock="Top" Text="选择会话后刷新材料。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeColor2}" Margin="4,0,4,10"/>
       <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="MaterialsResultText" Text="没有执行附件上传或原会话投递。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeColor9}" Margin="4,10"/><Expander Header="来源、版本与交付操作" FontSize="12"><ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,7,0,0"><WrapPanel><Button x:Name="MaterialsSourceButton" Content="登记虚构来源…"/><Button x:Name="MaterialsRetireButton" Content="退役来源登记…"/><Button x:Name="MaterialsSnapshotButton" Content="捕获 Working Tree…"/><Button x:Name="MaterialsPackageButton" Content="生成材料包…"/><Button x:Name="MaterialsSnapshotDetailsButton" Content="快照详情…"/></WrapPanel><Separator Margin="3,6"/><WrapPanel><Button x:Name="MaterialsExportButton" Content="导出待交付材料"/><Button x:Name="MaterialsHandoverButton" Content="准备人工交付清单…"/><Button x:Name="MaterialsHandoverReportButton" Content="登记人工交付报告…"/><Button x:Name="MaterialsMockReceiveButton" Content="分发给所选模拟对象"/><Button x:Name="MaterialsAttemptButton" Content="处理模拟待核对…"/></WrapPanel></StackPanel></ScrollViewer></Expander></StackPanel>
       <DataGrid x:Name="MaterialsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="材料包" Binding="{Binding ShortId}" Width="*"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="55"/><DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="65"/><DataGridTextColumn Header="材料状态" Binding="{Binding Status}" Width="155"/><DataGridTextColumn Header="生成时间" Binding="{Binding Created}" Width="145"/></DataGrid.Columns></DataGrid>
      </DockPanel>
     </TabItem>
     <TabItem Header="治理与证据">
      <DockPanel Margin="18,16">
