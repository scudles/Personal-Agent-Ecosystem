   <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="{DynamicResource ThemeColor4}"/><Setter Property="Foreground" Value="{DynamicResource ThemeColor5}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeColor6}"/><Setter Property="Cursor" Value="Hand"/>
