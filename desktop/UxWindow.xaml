  <SolidColorBrush x:Key="ThemeColor12" Color="#F1F4F8"/>
  <SolidColorBrush x:Key="ThemeColor13" Color="#E9EFF6"/>
  <SolidColorBrush x:Key="ThemeColor14" Color="#EEF0F3"/>
  <SolidColorBrush x:Key="ThemeColor15" Color="#F8F9FB"/>
