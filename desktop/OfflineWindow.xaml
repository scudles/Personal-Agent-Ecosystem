<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TriReviewBridge · 多项目原生协作工作台" Width="1420" Height="920" MinWidth="1080" MinHeight="730" Background="#101821" Foreground="#E8EEF5" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#DBEEE8"/><Setter Property="Foreground" Value="#132723"/><Setter Property="BorderBrush" Value="#55796F"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="Background" Value="#182736"/><Setter Property="Foreground" Value="#EDF4F8"/><Setter Property="BorderBrush" Value="#476276"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#14212D"/><Setter Property="Foreground" Value="#E8EEF5"/><Setter Property="BorderBrush" Value="#334B5E"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="#E8EEF5"/><Setter Property="Padding" Value="4,6"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="18,9"/><Setter Property="Foreground" Value="#152A35"/></Style>
 </Window.Resources>
 <DockPanel Margin="18">
  <Border DockPanel.Dock="Top" Background="#2D342D" BorderBrush="#819679" BorderThickness="1" Padding="12" Margin="0,0,0,12"><DockPanel><TextBlock Text="仅模拟 Adapter · 真实会话投递未授权 · 不操作 DeepSeek 草稿" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="协调与审议 · 保持各方独立" HorizontalAlignment="Right" Foreground="#B6C7BE"/></DockPanel></Border>
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="NewWindowButton" Content="另开原生窗口"/><Button x:Name="RefreshButton" Content="刷新"/><Button x:Name="StopBackendButton" Content="停止后台…"/><Button x:Name="CloseWindowButton" Content="关闭窗口"/></StackPanel><StackPanel><TextBlock Text="TriReviewBridge" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="LocationText" Text="选择项目与 Workspace" Foreground="#A9C4CF" Margin="0,4,0,0"/></StackPanel></DockPanel>
  <Border DockPanel.Dock="Bottom" BorderBrush="#354E62" BorderThickness="0,1,0,0" Padding="8" Margin="0,12,0,0"><DockPanel><TextBlock x:Name="StatusText" Text="连接本机后台…" TextWrapping="Wrap"/><TextBlock DockPanel.Dock="Right" Text="关闭窗口不会停止后台；只做文字协作。" Foreground="#9CB3C1" HorizontalAlignment="Right"/></DockPanel></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="275"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6"><Button x:Name="NewProjectButton" Content="新建项目"/><Button x:Name="RenameProjectButton" Content="重命名"/><Button x:Name="ArchiveProjectButton" Content="归档"/><Button x:Name="ProjectSettingsButton" Content="项目设置/权限"/><Button x:Name="KnowledgeButton" Content="项目知识"/><Button x:Name="NewWorkspaceButton" Content="新建 Workspace"/></WrapPanel><TextBlock DockPanel.Dock="Top" Text="项目 / 独立协作空间（原生会话不会自动创建）" Foreground="#9CB8C8" TextWrapping="Wrap" Margin="4,5,4,10"/><TreeView x:Name="ProjectTree" Background="#14212D" BorderBrush="#334B5E"/></DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Grid.Row="0"><Button x:Name="RenameWorkspaceButton" Content="窗口名称"/><Button x:Name="ParticipantsButton" Content="参与者"/><Button x:Name="BindButton" Content="绑定模拟会话"/><Button x:Name="PauseBindingButton" Content="暂停/恢复选中接入"/><Button x:Name="PauseWorkspaceButton" Content="暂停/恢复此空间"/><Button x:Name="ArchiveWorkspaceButton" Content="归档空间"/><CheckBox x:Name="DiscussionCheck" Content="明确开启受限定向讨论" Foreground="#B9D4C9" VerticalAlignment="Center" Margin="10,0"/></WrapPanel>
    <DockPanel Grid.Row="1" Margin="0,8"><TextBlock Text="接收方选择 / @ 定向" VerticalAlignment="Center" Margin="8,0,15,0"/><ListBox x:Name="RecipientList" SelectionMode="Multiple" Height="52" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></DockPanel>
    <TextBlock Grid.Row="2" x:Name="RecipientHint" Text="未选择收件人时禁止发送；正文、引用和代码中的 @ 不触发路由。" Foreground="#9CB8C8" Margin="8,0,8,8" TextWrapping="Wrap"/>
    <TabControl Grid.Row="3" x:Name="MainTabs" Background="#14212D" BorderBrush="#334B5E">
     <TabItem Header="对话与消息"><DockPanel Margin="10">
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><Border x:Name="ReplyBanner" Background="#28443F" Padding="8" Visibility="Collapsed"><DockPanel><Button x:Name="CancelReplyButton" Content="取消引用" DockPanel.Dock="Right"/><TextBlock x:Name="ReplyText" TextWrapping="Wrap"/></DockPanel></Border><TextBox x:Name="Composer" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,4" ToolTip="只依据上方选中的接收方投递；Ctrl+Enter 发送。"/><DockPanel><Button x:Name="SendButton" Content="定向发送 / 排队" DockPanel.Dock="Right" MinWidth="160"/><TextBlock Text="只收发文字。普通对话不构成正式审批或项目实施授权。" Foreground="#9CB8C8" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></StackPanel>
      <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><Button x:Name="RestoreDraftButton" Content="恢复本空间草稿…"/><Button x:Name="AttachKnowledgeButton" Content="附加知识版本…"/><Button x:Name="ObservationButton" Content="记录差异观察"/><Button x:Name="ReplyButton" Content="回复选中消息"/><Button x:Name="ForwardButton" Content="转交给 Agent…"/><Button x:Name="MessageTaskButton" Content="创建文字任务…"/><Button x:Name="MessageReviewButton" Content="发起审批…"/><Button x:Name="MessageDetailsButton" Content="来源与技术详情"/></WrapPanel>
      <ListBox x:Name="MessageList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"><ListBox.ItemTemplate><DataTemplate><Border Background="#1D3040" BorderBrush="#395A70" BorderThickness="1" CornerRadius="6" Padding="12" Margin="2,4"><StackPanel><DockPanel><TextBlock Text="{Binding AuthorLabel}" FontWeight="Bold" Foreground="#B6E9DA"/><TextBlock Text="{Binding TimeLabel}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#9CB8C8" FontSize="11"/></DockPanel><TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="23" Margin="0,8,0,6"/><TextBlock Text="{Binding StateLabel}" Foreground="#A9C6D4" FontSize="11" TextWrapping="Wrap"/><Expander Header="技术详情（默认折叠）" Foreground="#A8C9D5" FontSize="11" Margin="0,6,0,0"><TextBox Text="{Binding Technical}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     </DockPanel></TabItem>
     <TabItem Header="任务与审批"><DockPanel Margin="10"><WrapPanel DockPanel.Dock="Top"><Button x:Name="NewTaskButton" Content="新建文字任务…"/><Button x:Name="NewReviewButton" Content="新建正式审批…"/><Button x:Name="CrossButton" Content="明确开启交叉审查…"/><Button x:Name="ReviewRecordButton" Content="记录分歧/结论…"/><Button x:Name="ReviseButton" Content="修订并重新审批…"/><Button x:Name="CancelItemButton" Content="取消事项"/><Button x:Name="AuthorizeButton" Content="记录用户明确授权…"/><Button x:Name="ItemDetailsButton" Content="快照、意见与历史"/></WrapPanel><DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#E8F0F5" Foreground="#142939" GridLinesVisibility="Horizontal" RowHeight="32" SelectionMode="Single" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="性质" Binding="{Binding TypeLabel}" Width="80"/><DataGridTextColumn Header="事项" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="150"/><DataGridTextColumn Header="版本" Binding="{Binding Revision}" Width="55"/><DataGridTextColumn Header="用户授权" Binding="{Binding Authorized}" Width="90"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem Header="工程材料"><DockPanel Margin="10">
      <TextBlock DockPanel.Dock="Top" Text="离线材料 · 完整文字可查看 · 导出后待人工交付，三方尚未接收" Foreground="#B6E9DA" TextWrapping="Wrap" Margin="4,8"/>
      <WrapPanel DockPanel.Dock="Top"><Button x:Name="MaterialsRefreshButton" Content="刷新材料"/><Button x:Name="MaterialsSourceButton" Content="登记虚构工程来源…"/><Button x:Name="MaterialsRetireButton" Content="退役来源登记…"/><Button x:Name="MaterialsSnapshotDetailsButton" Content="快照详情…"/><Button x:Name="MaterialsAttemptButton" Content="处理模拟待核对…"/><Button x:Name="MaterialsSnapshotButton" Content="捕获 Working Tree…"/><Button x:Name="MaterialsPackageButton" Content="生成材料包…"/></WrapPanel>
      <TextBlock x:Name="MaterialsReceiptsText" DockPanel.Dock="Top" Foreground="#B6E9DA" TextWrapping="Wrap" Margin="6,4" Text="未发生模拟材料接收；真实三方未交付。"/><TextBlock x:Name="MaterialsSourceText" DockPanel.Dock="Top" Text="选择空间后刷新材料。" TextWrapping="Wrap" Foreground="#A9C6D4" Margin="6,10"/>
      <WrapPanel DockPanel.Dock="Bottom"><Button x:Name="MaterialsHandoverButton" Content="准备人工交付清单…"/><Button x:Name="MaterialsHandoverReportButton" Content="登记人工交付报告…"/><Button x:Name="MaterialsMockReceiveButton" Content="分发给选中的模拟对象"/><Button x:Name="MaterialsReadButton" Content="阅读选定材料"/><Button x:Name="MaterialsVerifyButton" Content="校验文件完整性"/><Button x:Name="MaterialsExportButton" Content="导出待交付材料"/><Button x:Name="MaterialsDetailsButton" Content="版本与哈希详情"/></WrapPanel>
      <TextBlock x:Name="MaterialsResultText" DockPanel.Dock="Bottom" Foreground="#B6E9DA" TextWrapping="Wrap" Margin="6,10" Text="没有执行附件上传或原会话投递。"/>
      <DataGrid x:Name="MaterialsGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#E8F0F5" Foreground="#142939" SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="材料包" Binding="{Binding ShortId}" Width="*"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="65"/><DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="65"/><DataGridTextColumn Header="材料状态" Binding="{Binding Status}" Width="180"/><DataGridTextColumn Header="生成时间" Binding="{Binding Created}" Width="160"/></DataGrid.Columns></DataGrid>
     </DockPanel></TabItem>
     <TabItem Header="治理与证据"><DockPanel Margin="10">
      <TextBlock DockPanel.Dock="Top" Text="MAG-001 已生效 · 当前仅模拟工程流程 · 不授予真实项目实施权限" Foreground="#B6E9DA" Margin="5,8" TextWrapping="Wrap"/>
      <WrapPanel DockPanel.Dock="Top"><Button x:Name="GovRefreshButton" Content="刷新"/><Button x:Name="GovRegisterButton" Content="登记工程治理…"/><Button x:Name="GovRoundButton" Content="开始必要复核…"/><Button x:Name="GovOpinionButton" Content="记录版本意见…"/><Button x:Name="GovIssueButton" Content="登记问题…"/><Button x:Name="GovIssueStateButton" Content="处理问题…"/><Button x:Name="GovCheckButton" Content="检查模拟交付条件…"/><Button x:Name="GovIntentButton" Content="核对治理请求…"/></WrapPanel>
      <TextBlock x:Name="GovResultText" DockPanel.Dock="Bottom" Text="普通文字审批保持原规则；工程治理按风险分级。" Foreground="#B6E9DA" TextWrapping="Wrap" Margin="5,10"/>
      <Grid><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid x:Name="GovTasksGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" Background="#E8F0F5" Foreground="#142939" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="负责人" Binding="{Binding Owner}" Width="100"/><DataGridTextColumn Header="等级" Binding="{Binding Risk}" Width="65"/><DataGridTextColumn Header="必要复核" Binding="{Binding Reviewers}" Width="150"/><DataGridTextColumn Header="轮次" Binding="{Binding Rounds}" Width="65"/></DataGrid.Columns></DataGrid>
      <ListBox x:Name="GovEvidenceList" Grid.Row="1" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#1D3040" Padding="12" Margin="2,4"><StackPanel><TextBlock Text="{Binding Heading}" Foreground="#B6E9DA" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding Body}" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Foreground="#A9C6D4" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
     </DockPanel></TabItem>
    </TabControl>
   </Grid>
  </Grid>
 </DockPanel>
</Window>